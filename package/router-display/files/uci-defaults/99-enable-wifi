#!/bin/sh
# First-boot setup for the display build.
#
# 1. Bring the AP up. OpenWrt ships every radio disabled by default, and on a
#    stick whose only other way in is the USB gadget that means one bad gadget
#    config leaves the device completely unreachable - which is exactly how we
#    locked ourselves out once.
#
# 2. Stop the power button from powering the device off. It is the only button
#    on the case and we use it to drive the display, so the stock handler has
#    to go. It cannot be shipped as a package file (base-files owns that path),
#    hence rewriting it here.

uci -q batch <<EOF
set wireless.@wifi-device[0].disabled='0'
set wireless.@wifi-device[0].channel='1'
set wireless.@wifi-device[0].country='RU'
set wireless.@wifi-iface[0].ssid='OpenWrt'
set wireless.@wifi-iface[0].encryption='none'
set wireless.@wifi-iface[0].mode='ap'
set wireless.@wifi-iface[0].disabled='0'
set wireless.@wifi-iface[0].network='lan'
commit wireless
EOF

cat > /etc/rc.button/power <<'EOF'
#!/bin/sh
# The button is the display's control: a press wakes the screen and a double
# press shows the Wi-Fi QR code, handled through /etc/hotplug.d/button. Those
# must never reach the shutdown path, which is why short presses exit here.
#
# A deliberate hold still powers the device down - without it there is no way
# to switch the thing off at all, since the PMIC brings it back up the moment
# USB is plugged in.
[ "${ACTION}" = "released" ] || exit 0

# Ignore the button for the first minute. Powering the device on takes a long
# hold, and if that hold outlasts the boot - which it easily can - the release
# lands on a running system that sees a three second press and shuts straight
# back down. The device then looks as though it refuses to start at all.
UP=$(cut -d. -f1 /proc/uptime)
[ "${UP:-0}" -ge 60 ] || exit 0

[ "${SEEN:-0}" -ge 3 ] || exit 0
poweroff
EOF
chmod +x /etc/rc.button/power

exit 0
